# Copy to .env for standalone runs. Inside infra, values come from infra/.env. Never commit .env (Article IX).
APP_NAME="Manager Library"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=change-me

# No Laravel tables: the model has exactly six tables (data-model.md §2)
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null

# At least 32 characters (HS256). Generate with: openssl rand -hex 32
JWT_SECRET=change-me-at-least-32-characters-long-random
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
COVERS_DIR=storage/app/covers
CORS_ORIGIN=http://localhost:5173
